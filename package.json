{
  "name": "washi",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/washi/*",
    "packages/shared/*"
  ],
  "scripts": {
    "start": "bun run --cwd apps/desktop dev",
    "dev": "bun run start",
    "build": "turbo run check-types build",
    "typecheck": "turbo run check-types",
    "check-types": "turbo run check-types",
    "build:app": "bun run --cwd apps/desktop build:app",
    "release": "bun run --cwd apps/desktop release",
    "clean": "rm -rf build dist .turbo .mirin .cache apps/desktop/build apps/desktop/dist apps/desktop/.mirin node_modules apps/*/node_modules packages/*/*/node_modules",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "check": "biome check .",
    "test": "bun test",
    "prepare": "husky",
    "dev:server": "bun run apps/server/src/main.ts",
    "dev:web": "bun run --cwd apps/web dev"
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@mirinjs/cli": "0.1.0-alpha.25",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "husky": "^9.1.7",
    "turbo": "^2.10.4",
    "typescript": "~5.9.3"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "0.3.228",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "0.3.228",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "0.3.228",
    "@anthropic-ai/claude-agent-sdk-linux-x64": "0.3.228",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "0.3.228",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "0.3.228",
    "@mirinjs/darwin-arm64": "0.1.0-alpha.25",
    "@mirinjs/linux-arm64": "0.1.0-alpha.25",
    "@mirinjs/linux-x64": "0.1.0-alpha.25",
    "@mirinjs/win32-arm64": "0.1.0-alpha.25",
    "@mirinjs/win32-x64": "0.1.0-alpha.25"
  }
}
