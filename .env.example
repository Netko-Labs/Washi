# Hosted mode only. The desktop app runs embedded and needs none of this.
WASHI_MODE=hosted

# Postgres holds the control plane — accounts, organizations, members,
# invitations and encrypted API keys. It never holds a sheet (see docs/server.html C1).
WASHI_DATABASE_URL=postgres://washi:washi@localhost:5432/washi

# Session secret AND the root of every workspace's BYOK key derivation.
# 32+ characters; the server refuses to boot below that.
#   openssl rand -base64 48
WASHI_SECRET_KEY=

# Public origin, for auth callbacks and cookie scope.
WASHI_BASE_URL=http://localhost:3000

# Where the per-workspace SQLite files live. Back this up — it is the content.
WASHI_DATA_DIR=/var/lib/washi/workspaces

# Comma-separated extra origins allowed to call the API (the web client).
WASHI_TRUSTED_ORIGINS=

WASHI_PORT=3000
WASHI_HOSTNAME=0.0.0.0
