# Hosted mode only. The desktop app runs embedded and needs none of this.
WASHI_MODE=hosted

# Postgres holds the control plane — accounts, organizations, members,
# invitations and encrypted API keys. It never holds a sheet (see docs/server.html C1).
# From source against the compose database, leave the password out of the url
# and set PGPASSWORD to the same value as POSTGRES_PASSWORD — no url-encoding.
WASHI_DATABASE_URL=postgres://washi@localhost:5432/washi
PGPASSWORD=

# The compose Postgres password. Required; there is no default.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Session secret AND the root of every workspace's BYOK key derivation.
# 32+ characters; the server refuses to boot below that.
#   openssl rand -base64 48
WASHI_SECRET_KEY=

# Public origin, for auth callbacks and cookie scope.
WASHI_BASE_URL=http://localhost:3000

# Where the per-workspace SQLite files live. Back this up — it is the content.
WASHI_DATA_DIR=/var/lib/washi/workspaces

# Comma-separated extra origins allowed to call the API with the session cookie.
# The studio serves its own web client, so this is usually empty.
WASHI_TRUSTED_ORIGINS=

# The studio's port (Nitro reads PORT).
PORT=3000

# Web search keys are per workspace (Settings → Agent → Web search), never env, on a team server.
# The desktop has no settings for it yet: it reads EXA_API_KEY from its environment.
