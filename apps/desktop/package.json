{
  "name": "@washi/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "mirin dev",
    "build": "vite build",
    "check-types": "bun run check-types:renderer && bun run check-types:bun && bun run check-types:config",
    "check-types:renderer": "tsgo -p tsconfig.app.json --noEmit",
    "check-types:bun": "tsgo -p tsconfig.bun.json --noEmit",
    "check-types:config": "tsgo -p tsconfig.node.json --noEmit",
    "check": "mirin check --scenario ./check.ts",
    "build:app": "mirin build",
    "release": "mirin release"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/karla": "^5.3.0",
    "@fontsource/m-plus-rounded-1c": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "@tabler/icons-react": "^3.44.0",
    "@tailwindcss/vite": "^4.3.2",
    "@washi/desktop-api": "workspace:*",
    "@washi/desktop-domain": "workspace:*",
    "@washi/desktop-repository": "workspace:*",
    "@washi/desktop-service": "workspace:*",
    "@washi/hanko": "workspace:*",
    "@washi/ink": "workspace:*",
    "@washi/paper": "workspace:*",
    "@washi/wsx": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "mirinjs": "0.1.0-alpha.19",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@washi/typescript-config": "workspace:*",
    "tw-animate-css": "^1.4.0",
    "vite": "^7.3.6"
  }
}
