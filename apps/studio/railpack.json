{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "steps": {
    "install": {
      "deployOutputs": [],
      "commands": ["bun install --frozen-lockfile --ignore-scripts --filter @washi/studio"]
    },
    "build": {
      "deployOutputs": [],
      "commands": ["bun run --cwd apps/studio build"]
    }
  },
  "deploy": {
    "paths": ["/mise/installs/bun/latest/bin"],
    "inputs": [
      {
        "step": "packages:mise",
        "include": ["/mise/installs/bun"]
      },
      { "step": "build", "include": ["apps/studio/.output"] }
    ],
    "aptPackages": ["curl"],
    "variables": { "CI": "", "NODE_ENV": "production" },
    "startCommand": "bun --no-install apps/studio/.output/server/index.mjs"
  }
}
